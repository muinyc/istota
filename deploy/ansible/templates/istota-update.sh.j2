#!/bin/bash
# {{ istota_namespace | capitalize }} auto-update script - managed by Ansible
set -euo pipefail

REPO_DIR="{{ istota_repo_dir }}"
REPO_BRANCH="{{ istota_repo_branch }}"
REPO_TAG="{{ istota_repo_tag }}"
NAMESPACE="{{ istota_namespace }}"
PACKAGE="{{ istota_package }}"
USER="{{ istota_user }}"
GROUP="{{ istota_group }}"
HOME_DIR="{{ istota_home }}"
DB_PATH="{{ istota_home }}/data/istota.db"
LOG="/var/log/{{ istota_namespace }}/{{ istota_namespace }}-update.log"
LOCK="/tmp/{{ istota_namespace }}-update.lock"
# ISSUE-428: what the last run *finished*, which is not where HEAD points.
# `git reset --hard` lands before anything that can fail, so under
# `set -euo pipefail` a later failure left HEAD at the target and every
# subsequent run exiting 0 on a half-applied deploy — indefinitely, with the
# reason only in this log. The early exits below compare against this marker
# instead. Outside the checkout, which `git reset --hard` and a re-clone both
# rewrite; the Ansible role writes it too, at the end of a play.
DEPLOYED_MARKER="/var/lib/{{ istota_namespace }}/last-deployed-sha"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}

exec >> "$LOG" 2>&1

# Acquire exclusive lock (exit silently if another run is in progress)
exec 200>"$LOCK"
flock -n 200 || exit 0

cd "$REPO_DIR"

mkdir -p "$(dirname "$DEPLOYED_MARKER")"
# Written through a temp file in both places: a redirection creates the target
# before the writer runs, so a failing `git rev-parse` would leave a zero-byte
# marker behind and every later run would read it as "" — a full redeploy on
# every tick, which is the outcome the seeding below exists to avoid. `-s`
# rather than `-f` for the same reason, so an empty marker reads as missing.
record_deployed() {
    printf '%s\n' "$1" > "${DEPLOYED_MARKER}.tmp" && mv "${DEPLOYED_MARKER}.tmp" "$DEPLOYED_MARKER"
}

if [ ! -s "$DEPLOYED_MARKER" ]; then
    # No marker: either a fresh host, or the first tick after this script
    # shipped. Both are a checkout the play deployed in full, so record it
    # rather than acting on it — treating "unknown" as "stale" would restart
    # every unit on every host at once, once, for nothing.
    record_deployed "$(git rev-parse HEAD)"
fi
DEPLOYED=$(cat "$DEPLOYED_MARKER")

# Reap stale claude CLI builds. The CLI self-updates on its own schedule and
# leaves every previous version behind at ~320MB each; nothing else removes
# them. This runs before the "already up to date" early exits below, because
# claude's release cadence has nothing to do with this repo's — gating the
# prune on an istota update meant it never ran on a tag-pinned host.
#
# Keep the newest N by mtime and always spare the build the launcher points at:
# after a rollback the live build is deliberately not the newest file. The
# comparison is on the entry *name* rather than the full path, because
# `readlink -f` canonicalises every component while a concatenated path does
# not — the two only match when no parent directory is a symlink.
CLAUDE_VERSIONS_KEEP={{ istota_claude_versions_keep }}
CLAUDE_VERSIONS_DIR="${HOME_DIR}/.local/share/claude/versions"
# A non-numeric or empty override would make $((KEEP + 1)) evaluate to 1, i.e.
# "delete everything". Refuse the value rather than the directory.
if ! [ "$CLAUDE_VERSIONS_KEEP" -ge 1 ] 2>/dev/null; then
    log "WARNING: claude_versions_keep is not a positive integer, skipping prune"
elif [ -d "$CLAUDE_VERSIONS_DIR" ]; then
    CLAUDE_LIVE_NAME="$(basename "$(readlink -f "${HOME_DIR}/.local/bin/claude" 2>/dev/null || true)")"
    if [ -z "$CLAUDE_LIVE_NAME" ] || [ ! -e "${CLAUDE_VERSIONS_DIR}/${CLAUDE_LIVE_NAME}" ]; then
        # A guard that cannot name the live build must not delete anything.
        log "WARNING: cannot resolve the live claude build, skipping prune"
    else
        # Best-effort: this must not abort the run under set -e.
        ls -1t "$CLAUDE_VERSIONS_DIR" 2>/dev/null | tail -n +$((CLAUDE_VERSIONS_KEEP + 1)) | \
        while IFS= read -r stale_version; do
            [ -n "$stale_version" ] || continue
            [ "$stale_version" != "$CLAUDE_LIVE_NAME" ] || continue
            # rm -rf, not -f: a future layout where a version is a directory
            # would otherwise fail silently and reclaim nothing. $stale_version
            # comes from ls and cannot contain a slash.
            if rm -rf "${CLAUDE_VERSIONS_DIR}/${stale_version}"; then
                log "Removed stale claude version ${stale_version}"
            else
                log "WARNING: could not remove claude version ${stale_version}"
            fi
        done || true
    fi
fi


# ISSUE-258: the clone token now comes from a credential helper rather than
# from remote.origin.url, so a missing or revoked token makes git ask for a
# username instead of failing. There is no terminal here and stdin is not
# closed, so a prompt would hang this run forever while holding the flock —
# every later run would then exit silently at the lock and updates would stop
# with nothing reported. Fail fast instead and leave the reason in the log.
export GIT_TERMINAL_PROMPT=0

git fetch origin --tags --quiet

if [ -n "$REPO_TAG" ]; then
    # Tag mode: resolve latest semver tag and check if we need to update
    if [ "$REPO_TAG" = "latest" ]; then
        TARGET_TAG=$(git tag -l 'v*' --sort=-v:refname | head -1)
    else
        TARGET_TAG="$REPO_TAG"
    fi

    if [ -z "$TARGET_TAG" ]; then
        log "ERROR: No semver tags found in repository"
        exit 1
    fi

    CURRENT=$(git rev-parse HEAD)
    TARGET=$(git rev-parse "$TARGET_TAG^{}" 2>/dev/null || git rev-parse "$TARGET_TAG")

    # Both conditions: the checkout is where it should be *and* a run got all
    # the way through at that sha. Either one alone leaves a deployment stuck.
    if [ "$CURRENT" = "$TARGET" ] && [ "$DEPLOYED" = "$TARGET" ]; then
        exit 0
    fi

    log "Updating to tag $TARGET_TAG ($CURRENT -> $TARGET)"
    git reset --hard "$TARGET_TAG" --quiet
else
    # Branch mode: check if remote has new commits
    CURRENT=$(git rev-parse HEAD)
    TARGET=$(git rev-parse "origin/$REPO_BRANCH")

    if [ "$CURRENT" = "$TARGET" ] && [ "$DEPLOYED" = "$TARGET" ]; then
        exit 0
    fi

    log "Updating branch $REPO_BRANCH ($CURRENT -> $TARGET)"
    git reset --hard "origin/$REPO_BRANCH" --quiet
fi

# Fix repo ownership
chown -R "${USER}:${GROUP}" "$REPO_DIR"

# Install/update dependencies
log "Installing dependencies"
UV_ARGS="sync"
{% if istota_install_all_extras | default(true) %}
UV_ARGS="$UV_ARGS --extra all"
{% else %}
{% if istota_memory_search_enabled %}
UV_ARGS="$UV_ARGS --extra memory-search"
{% endif %}
{% if istota_whisper_enabled %}
UV_ARGS="$UV_ARGS --extra whisper"
{% endif %}
{% if istota_location_enabled | default(false) %}
UV_ARGS="$UV_ARGS --extra location"
{% endif %}
{% endif %}
PATH="/root/.local/bin:$PATH" uv $UV_ARGS

# Fix venv ownership
chown -R "${USER}:${GROUP}" "${REPO_DIR}/.venv"

{% if istota_web_enabled | default(false) %}
# ISSUE-428: `web/build` is gitignored, so the reset above brings the frontend
# sources and not the artifact. Without this the cron shipped a frontend-only
# commit, restarted every unit, and changed nothing a browser saw until
# somebody ran the play. `web_app` serves the bundle through `StaticFiles`,
# which reads from disk per request, so the build needs no restart ordered
# around it.
#
# Before the migrations and the restarts, deliberately: a build that fails
# then leaves the whole previous deployment intact rather than new services
# against an old bundle, and the marker above means the next tick retries it.
#
# Diffed from $DEPLOYED, never from $CURRENT. On a retry — the case the marker
# exists for — the previous run's `git reset --hard` already landed, so
# $CURRENT is $TARGET and a diff between them is empty: a run that died in the
# build would skip the build on every retry afterwards and then record itself
# complete, latching ISSUE-428's own symptom permanently instead of until the
# next play. $DEPLOYED is what is actually live, which is the question.
#
# Two diffs rather than one filtered through a pipe: `git diff | grep -q` gets
# the writer SIGPIPE'd when grep exits on its first match, which `pipefail`
# turns into a failed run.
#
# The marker lives outside the checkout and outlives a re-clone or a history
# rewrite, so the sha it names may resolve to nothing. Build rather than abort:
# `git diff` against a missing object exits non-zero, which under `set -e` ends
# the run before the migrations and the restarts, every tick, for good.
if git cat-file -e "${DEPLOYED}^{commit}" 2>/dev/null; then
    WEB_CHANGED=$(git diff --name-only "$DEPLOYED" "$TARGET" -- web/)
    WEB_LOCK_CHANGED=$(git diff --name-only "$DEPLOYED" "$TARGET" -- web/package-lock.json)
else
    log "WARNING: deployed revision ${DEPLOYED} is unknown to this checkout, rebuilding the web UI"
    WEB_CHANGED="unknown-revision"
    WEB_LOCK_CHANGED="unknown-revision"
fi

if [ -n "$WEB_CHANGED" ]; then
    # A missing npm must not stop the Python half from deploying. The build
    # sits ahead of the migrations and the restarts so a *failed* build leaves
    # the previous deployment intact, but a host that can never build (node
    # installed outside this role, or not at all) would then wedge the whole
    # pipeline on every tick with the reason only in this log. Skipped loudly
    # instead, and `doctor`'s `web.build_current` is what reports the bundle
    # left behind.
    if ! command -v npm > /dev/null 2>&1; then
        log "ERROR: web/ changed but npm is not on PATH; skipping the frontend build"
    else
        # `npm ci` wipes and reinstalls node_modules and is the expensive half.
        # Only a lockfile change requires it; the role runs both unconditionally,
        # which is right for a play and wasteful on a two-minute cron.
        if [ -n "$WEB_LOCK_CHANGED" ] || [ ! -d "${REPO_DIR}/web/node_modules" ]; then
            log "Installing web UI dependencies"
            (cd "${REPO_DIR}/web" && npm ci)
        fi
        log "Building web UI"
        (cd "${REPO_DIR}/web" && ISTOTA_BUILD_SHA="$TARGET" npm run build)
        # The repo-wide chown above ran before this, so node_modules and build
        # are root-owned without it. The unit only reads the bundle, so the
        # default umask hides the difference — settled here rather than
        # inherited.
        chown -R "${USER}:${GROUP}" "${REPO_DIR}/web"
    fi
fi
{% endif %}

# Run DB migrations
log "Running database migrations"
"${HOME_DIR}/.venv/bin/python" -c "from pathlib import Path; import sys; sys.path.insert(0, 'src'); from ${PACKAGE}.db import init_db; init_db(Path('${DB_PATH}'))"
sqlite3 "$DB_PATH" "ALTER TABLE processed_emails ADD COLUMN \"references\" TEXT;" 2>/dev/null || true
sqlite3 "$DB_PATH" "ALTER TABLE tasks ADD COLUMN output_target TEXT;" 2>/dev/null || true
sqlite3 "$DB_PATH" "ALTER TABLE scheduled_jobs ADD COLUMN output_target TEXT;" 2>/dev/null || true

# Fix DB ownership
chown "${USER}:${GROUP}" "$DB_PATH"

# Restart services. All long-running Python services hold the old code in
# memory until restarted — restarting only the scheduler left the web UI and
# webhook receiver serving stale code after every auto-update. Gated on the
# same flags as the Ansible restart handlers.
log "Restarting ${NAMESPACE}-scheduler"
systemctl restart "${NAMESPACE}-scheduler"
{% if istota_web_enabled | default(false) %}
log "Restarting ${NAMESPACE}-web"
systemctl restart "${NAMESPACE}-web"
{% endif %}
{% if istota_location_enabled | default(false) %}
log "Restarting ${NAMESPACE}-webhooks"
systemctl restart "${NAMESPACE}-webhooks"
{% endif %}
{% if istota_devbox_enabled and not istota_web_only and (istota_devbox_users | length > 0) %}
# The credential proxy imports from the checkout as well, and it is a security
# boundary: it holds the tokens. Left out of this list it kept serving the
# pre-update module indefinitely, which is how the ISSUE-294 keep-alive bypass
# stayed live after its fix merged. (The Docker-API proxy used to be restarted
# here too, and is retired — nothing in a task reaches Docker.)
{% for devbox_user in istota_devbox_users %}
{% if istota_devbox_proxy_enabled %}
log "Restarting ${NAMESPACE}-devbox-proxy@{{ devbox_user }}"
systemctl restart "${NAMESPACE}-devbox-proxy@{{ devbox_user }}"
{% endif %}
{% endfor %}
{% endif %}

# Last, and only here: everything above it is what "deployed" means. A failure
# anywhere earlier ends the run under `set -e` with the marker still naming the
# previous sha, so the next tick redoes the whole thing.
record_deployed "$TARGET"

log "Update complete"
