sandbox_cache_sweep_enabled = {{ istota_security_sandbox_cache_sweep_enabled | lower }}
sandbox_cache_max_gb = {{ istota_security_sandbox_cache_max_gb }}
{% endif %}

[security.network]
enabled = {{ istota_security_network_enabled | lower }}
allow_pypi = {{ istota_security_network_allow_pypi | lower }}
{% if istota_security_network_extra_hosts %}
extra_hosts = {{ istota_security_network_extra_hosts | to_json }}
{% endif %}

[nextcloud]
url = "{{ istota_nextcloud_url }}"
username = "{{ istota_nextcloud_username }}"
{% if not istota_use_environment_file %}
app_password = "{{ istota_nextcloud_app_password }}"
{% endif %}
share_default_expire_days = {{ istota_nextcloud_share_default_expire_days }}
{% if istota_caldav_url and istota_caldav_password %}

{# Explicit CalDAV server, overriding the [nextcloud] derivation Config.caldav_*
   otherwise uses. For a deployment whose calendar lives somewhere other than the
   Nextcloud it authenticates against. The password follows
   istota_email_imap_password — the EnvironmentFile on the shape the role
   deploys, inline only when the operator turned that file off.

   BOTH VARIABLES GATE THIS, and the pair is a credential boundary rather than
   tidiness. `Config.caldav_url` / `_username` / `_password` fall back to
   [nextcloud] INDEPENDENTLY, so a url with no password does not merely fail to
   authenticate: it renders a foreign host and lets caldav_password fall through
   to the Nextcloud app password, which the daemon then presents to that host.
   The reverse half leaks nothing but breaks calendar just as silently — the
   secrets file is gated on the same pair, since ISTOTA_CALDAV_PASSWORD reaches
   the loader whether or not a block renders, and on its own it authenticates to
   Nextcloud's own DAV endpoint with the wrong password.

   setup_wizard._collect_caldav applies exactly this rule for the standalone
   shape and says so out loud; a template cannot, so it fails closed. #}
[caldav]
url = "{{ istota_caldav_url }}"
username = "{{ istota_caldav_username }}"
{% if not istota_use_environment_file %}
password = "{{ istota_caldav_password }}"
{% endif %}
{% endif %}

[talk]
enabled = {{ istota_talk_enabled | lower }}
bot_username = "{{ istota_talk_bot_username }}"

[talk.signaling]
enabled = {{ istota_talk_signaling_enabled | lower }}
url = "{{ istota_talk_signaling_url }}"
room_sync_interval = {{ istota_talk_signaling_room_sync_interval }}
reconnect_backoff_max = {{ istota_talk_signaling_reconnect_backoff_max }}
payload_direct = {{ istota_talk_signaling_payload_direct | lower }}

[email]
enabled = {{ istota_email_enabled | lower }}
{% if istota_email_enabled %}
imap_host = "{{ istota_email_imap_host }}"
imap_port = {{ istota_email_imap_port }}
imap_user = "{{ istota_email_imap_user }}"
{% if not istota_use_environment_file %}
imap_password = "{{ istota_email_imap_password }}"
{% endif %}
smtp_host = "{{ istota_email_smtp_host }}"
smtp_port = {{ istota_email_smtp_port }}
poll_folder = "{{ istota_email_poll_folder }}"
bot_email = "{{ istota_email_bot_address }}"
imap_timeout_seconds = {{ istota_email_imap_timeout_seconds }}
confirm_sender_match = "{{ istota_email_confirm_sender_match }}"
dmarc_canary = {{ istota_email_dmarc_canary | lower }}
dmarc_canary_warn_on_missing = {{ istota_email_dmarc_canary_warn_on_missing | lower }}
authserv_id = "{{ istota_email_authserv_id }}"
outbound_approval_floor = "{{ istota_email_outbound_approval_floor }}"
{% endif %}

{# Model alias registry ([models.aliases]) — tiers (fast/general/smart) and
   shortcuts (opus/sonnet/haiku), overlaying the code-shipped defaults, resolved
   per active brain. istota_models_aliases is authoritative: a bare-string value is
   a legacy flat (namespace-agnostic) alias; a mapping value is a per-namespace
   table (anthropic = CLI brains, openai_compat = native) whose values are a bare
   slug or an inline {model, effort}, plus an optional `portable: true` flag (a
   sibling of the namespace keys) marking a custom alias cross-brain. Per-namespace
   resolution makes a native fallback's openai_compat target and a claude_code
   primary's anthropic target coexist correctly. A brain with no matching namespace
   key falls to its own code default. Effort is the orthogonal :effort modifier,
   never baked into an alias name. #}
{% if istota_models_aliases %}
[models.aliases]
{% for name, target in istota_models_aliases.items() if target is string %}
{{ name }} = "{{ target }}"
{% endfor %}
{% for name, target in istota_models_aliases.items() if target is mapping %}

[models.aliases.{{ name }}]
{% for ns, nsval in target.items() %}
{% if ns == "portable" %}
portable = {{ 'true' if nsval else 'false' }}
{% elif nsval is mapping %}
{{ ns }} = { model = "{{ nsval.model }}"{% if nsval.effort is defined and nsval.effort %}, effort = "{{ nsval.effort }}"{% endif %} }
{% else %}
{{ ns }} = "{{ nsval }}"
{% endif %}
{% endfor %}
{% endfor %}

{% endif %}
