{{ _default_briefings_toml }}
{% endif %}

{# Briefings module config. ``shared_block_timezone`` is the zone shared
   briefing block cron schedules evaluate in (global — shared blocks are
   generated once, not per-user). Default "UTC" preserves the historical
   behaviour; set to the operator's local zone so regeneration windows line
   up with their day. #}
[briefings]
shared_block_timezone = "{{ istota_briefing_shared_tz | default('UTC') }}"
newsletter_max_links_per_source = {{ istota_briefing_newsletter_max_links | default(20) }}

{# Health module config. max_document_bytes caps one attached document
   (scan / discharge summary / vaccination card); 0 = unlimited. #}
[health]
max_document_bytes = {{ istota_health_max_document_bytes | default(26214400) }}

{# Money module config. autoclass_lookup gates the portfolio module's ticker
