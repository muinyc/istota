# How the exec transport is configured — not whether it is used. That is
# derived from `[devbox] enabled` together with `[developer] enabled` and a
# non-empty `repos_dir`, so the two switches cannot disagree; the `backend` key
# that used to sit here is retired, and a file still carrying it gets a warning
# at load and a WARN from `istota doctor --only developer.container`. That check
# re-derives from this file rather than reading a key, which is also what says
# whether the file and the running daemon agree.
[developer.container]
exec_socket_dir = "{{ istota_developer_container_exec_socket_dir }}"
connect_timeout_seconds = {{ istota_developer_container_connect_timeout_seconds }}
idle_timeout_seconds = {{ istota_developer_container_idle_timeout_seconds }}
shim_commands = {{ istota_developer_container_shim_commands | to_json }}
{% endif %}

# User profiles, folder mounts, and briefing schedule/delivery live in the DB
# (user_profiles, user_resources, briefing_configs tables). They are populated by
# `istota user/resource/briefings schedule ensure` invocations in the playbook —
# config.toml does not render that per-user data.
#
# The one exception: config-authored briefing *content blocks* are an
# in-memory-only Config field (never stored in briefing_configs), so they must be
# rendered into config.toml to reach the module-DB seeder. Only a content-only
# `[[users.X.briefings]]` stub (name + cron + nested blocks/sources) is emitted,
# and only for briefings that declare a `blocks:` list; schedule/delivery still
# flow through the CLI/DB path above, and `_apply_user_briefings` re-attaches
# these blocks onto the DB-sourced entry by name. To apply one definition across
# users, loop it over `istota_users` in the playbook.
{% set _briefing_blocks_toml = istota_users | istota_briefing_blocks_toml %}
{% if _briefing_blocks_toml %}

{{ _briefing_blocks_toml }}
{% endif %}
