# {{ istota_namespace | capitalize }} configuration - managed by Ansible

# Install namespace (drives /etc/{namespace}/, secrets paths, etc.)
namespace = "{{ istota_namespace }}"

# Bot identity
bot_name = "{{ istota_bot_name | default(istota_namespace | capitalize, true) }}"
emissaries_enabled = {{ istota_emissaries_enabled | lower }}
{# No top-level model/effort: they were claude_code's own defaults living at the
   root, applied to every brain (ISSUE-418). Rendered as [brain.claude_code] and
   [brain.tmux] below, which is where the role's own defaults migrate them. #}
{% if istota_advisor_model %}
advisor_model = "{{ istota_advisor_model }}"
{% endif %}
{% if istota_custom_system_prompt %}
custom_system_prompt = true
{% endif %}

# Database path. Filename is fixed (technical IDs are always istota); only
# the parent dir is per-deploy via {{ istota_home }}.
db_path = "{{ istota_home }}/data/istota.db"

# Local-disk root for per-user module DBs (feeds/health/location/money). Local
# disk, NOT the Nextcloud mount: WAL's -shm SIGBUSes on the FUSE mount. Only the
# .db lives here; user-facing module files stay in the workspace on the mount.
module_data_dir = "{{ istota_module_data_dir }}"

# File access configuration
{% if istota_use_nextcloud_mount %}
# Nextcloud mount path (direct filesystem access)
nextcloud_mount_path = "{{ istota_nextcloud_mount_path }}"
{% endif %}
# rclone remote name for Nextcloud files (used when mount_path not set, or for owner detection)
rclone_remote = "{{ istota_rclone_remote }}"

# Path to skills directory (individual skill files loaded selectively)
# Points to src/config/skills where skills and guidelines folders live in the repo
skills_dir = "{{ istota_repo_dir }}/config/skills"
{% if istota_disabled_skills %}
disabled_skills = {{ istota_disabled_skills | to_json }}
{% endif %}

# Temporary directory
temp_dir = "{{ istota_home }}/tmp"

# Experimental feature flags — operator opt-in for rough features that
# ship in the tree but are off by default. See docs/EXPERIMENTAL.md for
# the registry. Override via `istota_experimental_features` in
# host_vars / group_vars. Example: ["money_tax", "money_wash_sales"].
[experimental]
features = {{ istota_experimental_features | to_json }}

[brain]
# Which model-invocation backend the executor uses.
#   "claude_code" (default) wraps the headless `claude -p` CLI subprocess.
#   "native"                runs istota's own in-process agent loop.
#   "tmux_claude"           drives the interactive `claude` TUI via tmux
#                           (needs tmux on the host).
# Operator runbook: docs/configuration/native-brain.md.
kind = "{{ istota_brain_kind | default('claude_code', true) }}"
{% if istota_brain_room_selectable %}
# Brain kinds a room may pin for itself, with `!brain` or the web room settings,
# and a scheduled job with `brain` in CRON.md. Empty (the default) means none
# may. Writing either pin is admin-only on top of this, and neither fails over:
# it runs the brain it names or fails saying why. Listing a kind also widens the
# doctor checks for it.
room_selectable = {{ istota_brain_room_selectable | to_json }}
{% endif %}
{% if istota_brain_fallback %}
# Availability failover: when the primary brain above is unavailable (subscription
# usage limit / missing binary / tmux launch failure), run the task on this brain
# with its own configured [brain.native] / [brain.tmux] settings. A portable role
# tier (fast/general/smart) carries across; a provider-specific model pin drops to
# the fallback brain's own default (logged + noted in the reply). Omitted
# entirely = no fallback, whatever the primary kind.
fallback = "{{ istota_brain_fallback }}"
{% endif %}
{# No falsy flavour on default(): `| default(x, true)` treats a legitimate
   `false` — or a legitimate `0` — as "undefined" and substitutes the default,
   so an operator opting out would silently get the opt-in back (ISSUE-435).
   Every numeric below is a plain reference for the same reason, with the
   default in defaults/main.yml. An *undefined* variable then fails the render
   rather than being substituted in silence; a variable set to null or an empty
   string is defined, renders `None` or nothing, and is caught by the template
   task's `validate:` before it can replace the live config.toml. The few that
   keep the filter are the ones where 0 reaches no branch in the code, and each
   says so on its own line. #}
fallback_on_transient = {{ istota_brain_fallback_on_transient | default(true) | lower }}
{# 0 = no breaker stickiness: every task probes the primary again. #}
fallback_cooldown_seconds = {{ istota_brain_fallback_cooldown_seconds }}
{% if istota_brain_claude_code_model or istota_brain_claude_code_effort %}

[brain.claude_code]
# The headless `claude -p` brain's own default model and effort, used when
# nothing pins one for the task. Rendered whatever `kind` is, since a fallback
# or a source_type_overrides entry can route here from another primary.
{% if istota_brain_claude_code_model %}
model = "{{ istota_brain_claude_code_model }}"
{% endif %}
{% if istota_brain_claude_code_effort %}
effort = "{{ istota_brain_claude_code_effort }}"
{% endif %}
{% endif %}
{% if istota_brain_kind == 'native' or istota_brain_fallback == 'native' or istota_brain_source_type_overrides %}

[brain.native]
# Used when kind = "native", istota_brain_fallback = "native", or a
# source_type_overrides entry routes to native.
# The API key stays out of this file — see ISTOTA_BRAIN_NATIVE_API_KEY in the
# EnvironmentFile.
provider = "{{ istota_brain_native_provider | default('openai_compat', true) }}"
{% if istota_brain_native_model %}
model = "{{ istota_brain_native_model }}"
{% endif %}
{% if istota_brain_native_effort %}
effort = "{{ istota_brain_native_effort }}"
{% endif %}
base_url = "{{ istota_brain_native_base_url | default('https://api.anthropic.com/v1', true) }}"
{# 0 = resolve the window from the catalog / the conservative default. #}
context_window = {{ istota_brain_native_context_window }}
{# 0 = no turn cap (`if max_turns and turns >= max_turns`). #}
max_turns = {{ istota_brain_native_max_turns }}
{# max_tokens keeps the falsy default deliberately: it goes straight into the
   provider request body, where 0 is rejected rather than meaning anything, and
   the code has no branch for it. The literal is the role default from
   defaults/main.yml, not the dataclass default it used to be — an operator who
   writes a value this filter refuses should land on what they would have got
   by writing nothing, rather than on a third number nobody chose. #}
max_tokens = {{ istota_brain_native_max_tokens | default(32000, true) }}
# When base_url is OpenRouter, fetch its public model list once/process for real
# per-model window / capabilities / prices (self-updating, disk-cached, never
# fatal). No effect for a non-OpenRouter endpoint — set context_window there.
model_catalog_fetch = {{ istota_brain_native_model_catalog_fetch | default(true) | lower }}
{# 0 = the disk cache never expires (`if ttl_hours > 0 and ...`), not "do not
   cache" — the fetch is still gated on model_catalog_fetch above. #}
model_catalog_cache_ttl_hours = {{ istota_brain_native_model_catalog_cache_ttl_hours }}
# Spill full over-cap Bash output to a task-scoped temp file (named in the tool
# result) instead of dropping the tail; default on.
bash_spill_full_output = {{ istota_brain_native_bash_spill_full_output | default(true) | lower }}
# Turn-budget awareness nudge: as a tool-bearing run approaches max_turns, inject
# an environment notice so the model paces itself and delivers a partial answer
# instead of getting capped mid-plan. Fires once at the early-percent mark, then
# once each as absolute steps-remaining crosses each level. Default on.
turn_budget_nudge = {{ istota_brain_native_turn_budget_nudge | default(true) | lower }}
{# 0 = no early nudge; [] = no late ladder. Both are read as written. #}
turn_budget_nudge_early_percent = {{ istota_brain_native_turn_budget_nudge_early_percent }}
turn_budget_nudge_remaining = {{ istota_brain_native_turn_budget_nudge_remaining | to_json }}
# Soft wall-clock deadline: stop the loop a little before scheduler.task_timeout_
# minutes, on a stop that delivers the model's partial work. The hard clock
# discards it; max_turns delivers it, and on a slow brain the clock arrives
# first. The remaining slack still covers a turn that hangs. 0 or >= 100 disables.
soft_deadline_percent = {{ istota_brain_native_soft_deadline_percent }}
{# prompt_caching: "" (default) → omit so the code derives it from base_url
   (on for Anthropic). Emit when the operator forced a value — accepts a YAML
   boolean or a "true"/"false" string (e.g. passed via -e on the CLI, which
   arrives as a string and would otherwise be silently dropped). #}
{% if istota_brain_native_prompt_caching is boolean %}
prompt_caching = {{ istota_brain_native_prompt_caching | lower }}
{% elif (istota_brain_native_prompt_caching | string | trim | lower) in ["true", "false"] %}
prompt_caching = {{ istota_brain_native_prompt_caching | string | trim | lower }}
{% endif %}
{% if not istota_use_environment_file and istota_brain_native_api_key %}
api_key = "{{ istota_brain_native_api_key }}"
{% endif %}
{% if istota_brain_native_extra_headers %}

[brain.native.extra_headers]
{% for header, value in istota_brain_native_extra_headers.items() %}
"{{ header }}" = "{{ value }}"
{% endfor %}
{% endif %}

[brain.native.web_fetch]
# Daemon-side WebFetch tool for the native harness. Runs in the daemon (host
# netns), so it is NOT gated by the bwrap CONNECT allowlist — instead it is
# credential-free and SSRF-hardened (private/reserved destinations refused on
# every hop, connection pinned to the validated IP). Safe defaults; the whole
# block is optional.
enabled = {{ istota_brain_native_web_fetch_enabled | default(true) | lower }}
allow_http = {{ istota_brain_native_web_fetch_allow_http | lower }}
{# The next three keep the falsy default deliberately: none has a zero branch,
   and 0 renders a tool that is switched on and useless. `enabled = false`
   above is how this tool is turned off. #}
{# timeout_seconds: 0 is httpx.Timeout(0) — every fetch fails instantly. #}
timeout_seconds = {{ istota_brain_native_web_fetch_timeout_seconds | default(20, true) }}
{# max_bytes: 0 truncates every response body to nothing. #}
max_bytes = {{ istota_brain_native_web_fetch_max_bytes | default(5000000, true) }}
{# max_content_chars: 0 returns the model no extracted text at all. #}
max_content_chars = {{ istota_brain_native_web_fetch_max_content_chars | default(100000, true) }}
{# 0 = follow no redirects (`for hop in range(max_redirects + 1)`). #}
max_redirects = {{ istota_brain_native_web_fetch_max_redirects }}
require_url_provenance = {{ istota_brain_native_web_fetch_require_url_provenance | lower }}
{% if istota_brain_native_web_fetch_allow_hosts %}
allow_hosts = {{ istota_brain_native_web_fetch_allow_hosts | to_json }}
{% endif %}
{% if istota_brain_native_web_fetch_block_hosts %}
block_hosts = {{ istota_brain_native_web_fetch_block_hosts | to_json }}
{% endif %}
{% if istota_brain_native_web_fetch_extra_blocked_cidrs %}
extra_blocked_cidrs = {{ istota_brain_native_web_fetch_extra_blocked_cidrs | to_json }}
{% endif %}

[brain.native.session_log]
# One append-only JSONL transcript per native task attempt: the assembled
# prompt, every assistant turn, every tool call and every tool result. Every
# field defaults, so this block is somewhere to change one rather than a
# requirement.
#
# `dir` blank resolves to the directory holding db_path, plus /logs — local
# disk, and behind the sandbox's database mask. A value set here is used AS
# GIVEN, and the retention sweep unlinks *.jsonl under whatever it resolves to,
# so write an absolute path naming a directory istota owns.
#
# The two limits are independent and either can evict: retention_days for
# privacy, max_total_gb for the disk, summed across every user.
#
# Every value below is a plain reference rather than `| default(x, true)`:
# that filter substitutes on *falsy* as well as undefined, so it would render
# `enabled = true` for an operator who set false, and 14 for one who set the
# documented `retention_days = 0`. The defaults live in defaults/main.yml,
# where they belong, and a missing one fails the render instead.
enabled = {{ istota_brain_native_session_log_enabled | lower }}
dir = "{{ istota_brain_native_session_log_dir }}"
retention_days = {{ istota_brain_native_session_log_retention_days }}
max_total_gb = {{ istota_brain_native_session_log_max_total_gb }}
max_content_chars = {{ istota_brain_native_session_log_max_content_chars }}
max_args_chars = {{ istota_brain_native_session_log_max_args_chars }}
include_thinking = {{ istota_brain_native_session_log_include_thinking | lower }}
{% endif %}
{% set _tmux_routed = istota_brain_source_type_overrides.values() | select('equalto', 'tmux_claude') | list | length > 0 %}
{% if istota_brain_kind == 'tmux_claude' or istota_brain_fallback == 'tmux_claude' or _tmux_routed %}

[brain.tmux]
# Used when kind = "tmux_claude", istota_brain_fallback = "tmux_claude", or a
# source_type_overrides entry routes to it.
# All fields default in code to the prototype's pinned values; emit only the
# operability knobs here. Marker lists stay in code unless a CLI reword needs a
# hotfix (set istota_brain_tmux_ready_markers etc. then).
{% if istota_brain_tmux_model %}
model = "{{ istota_brain_tmux_model }}"
{% endif %}
{% if istota_brain_tmux_effort %}
effort = "{{ istota_brain_tmux_effort }}"
{% endif %}
{# 0 = open the circuit on the first launch failure; 0 = no cooldown, so the
   circuit never skips a task. Both are read as written. #}
fallback_trip_threshold = {{ istota_brain_tmux_fallback_trip_threshold }}
fallback_cooldown_seconds = {{ istota_brain_tmux_fallback_cooldown_seconds }}
{# The next two keep the falsy default deliberately: 0 reaches no branch in
   either. ready_timeout_seconds: 0 is a deadline of now, so the REPL is never
   ready and every task falls back. #}
ready_timeout_seconds = {{ istota_brain_tmux_ready_timeout_seconds | default(30, true) }}
{# tmux_command_timeout: 0 makes every tmux subprocess call time out. #}
tmux_command_timeout = {{ istota_brain_tmux_command_timeout | default(10, true) }}
cli_version_pin = "{{ istota_brain_tmux_cli_version_pin | default('2.1.168', true) }}"
{% if istota_brain_tmux_ready_markers %}
ready_markers = {{ istota_brain_tmux_ready_markers | to_json }}
{% endif %}
{% if istota_brain_tmux_trust_markers %}
trust_markers = {{ istota_brain_tmux_trust_markers | to_json }}
{% endif %}
{% if istota_brain_tmux_theme_markers %}
theme_markers = {{ istota_brain_tmux_theme_markers | to_json }}
{% endif %}
{% if istota_brain_tmux_error_markers %}
error_markers = {{ istota_brain_tmux_error_markers | to_json }}
{% endif %}
{% if istota_brain_tmux_usage_limit_markers %}
usage_limit_markers = {{ istota_brain_tmux_usage_limit_markers | to_json }}
{% endif %}
{% if istota_brain_tmux_bypass_warning_marker %}
bypass_warning_marker = "{{ istota_brain_tmux_bypass_warning_marker }}"
{% endif %}
{% if istota_brain_tmux_bypass_accept_marker %}
bypass_accept_marker = "{{ istota_brain_tmux_bypass_accept_marker }}"
{% endif %}
{% endif %}
{% if istota_brain_source_type_overrides %}

[brain.source_type_overrides]
{% for source_type, kind in istota_brain_source_type_overrides.items() %}
{{ source_type }} = "{{ kind }}"
{% endfor %}
{% endif %}

